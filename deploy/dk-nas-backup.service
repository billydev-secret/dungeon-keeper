# Off-device backup of the Dungeon Keeper database to the Synology NAS.
#
# Deliberately a SEPARATE unit from dungeon-keeper.service: the bot runs with
# ProtectHome=read-only and ReadWritePaths scoped to its own directory, and
# that hardening should stay intact. This unit does the outbound copy instead.
#
# Install: see deploy/README.md ("Off-device backup").
# Logs:    journalctl -u dk-nas-backup

[Unit]
Description=Dungeon Keeper off-device backup to NAS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ben
Group=ben
ExecStart=/home/ben/discord-bots/dungeon-keeper/scripts/backup_to_nas.sh

# The script verifies the backup before shipping it (sqlite quick_check on
# ~700 MB) and rsyncs over the LAN; give it room without hanging forever.
TimeoutStartSec=1800

# Hardening. Needs: read of the repo, read of /etc/systemd/system for the unit
# files it bundles, and write to ~/.local/state for the breadcrumb.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
ReadWritePaths=/home/ben/.local/state/dk-backup

[Install]
WantedBy=multi-user.target
